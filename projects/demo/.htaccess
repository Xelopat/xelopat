# Демо проектов: статичные копии сайтов. Адрес папки без слэша отдаёт её index.html.
# Свой RewriteEngine здесь отключает правила корневого .htaccess для этой папки.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*?)/?$ $1/index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpe?g|png|svg|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Демо-копии не индексируем: у isellcars есть боевой сайт, дубли ему ни к чему
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
