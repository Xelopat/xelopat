# Чистые адреса: /perfumes вместо /perfumes/index.php, /bases/mac вместо /bases/mac.php
<IfModule mod_rewrite.c>
RewriteEngine On

# Карта сайта для поисковиков собирается скриптом
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Не добавлять слэш к папкам: иначе Apache шлёт /dir -> /dir/, а правила ниже обратно, и выходит петля
DirectorySlash Off

# 1) Старые адреса ведут на новые (только GET/HEAD, чтобы не ломать POST-формы)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:[^\s?]*/)?index\.php[\s?]
RewriteRule ^(.*?)/?index\.php$ /$1 [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/[^\s?]*\.php[\s?]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# 2) Внутри сервера: /dir -> /dir/index.php, /page -> /page.php
RewriteCond %{DOCUMENT_ROOT}/$1/index.php -f
RewriteRule ^([^.]+?)/?$ $1/index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
</IfModule>
